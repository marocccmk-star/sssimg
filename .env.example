# --- Database (Render provides DATABASE_URL automatically) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/aiphoto

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET=aiphoto
# Public base URL of the bucket (custom domain or r2.dev public URL), no trailing slash
R2_PUBLIC_BASE_URL=https://images.yourdomain.com

# --- AI provider (fal.ai by default) ---
AI_PROVIDER=fal
FAL_API_KEY=your_fal_key
# Any fal image-to-image model id, e.g. fal-ai/flux/dev/image-to-image
FAL_MODEL=fal-ai/flux/dev/image-to-image

# --- App ---
# Public HTTPS base URL of THIS backend (used to build the AI webhook URL)
APP_BASE_URL=https://your-service.onrender.com
CORS_ORIGINS=*
MAX_UPLOAD_MB=15

# --- Mobile app (sssimg) extras ---
GOOGLE_API_KEY=
XAI_API_KEY=
LUMA_API_KEY=
# Optional JSON to remap wire model ids to provider models without code changes:
# MODEL_ROUTES={"wan-2.7":{"provider":"fal","remote":"fal-ai/your-wan-endpoint"}}
MODEL_ROUTES=
MAX_VIDEO_UPLOAD_MB=120
# Dev only: accept the app's placeholder token as a shared tester account
ALLOW_ANON_TEST=true
